{
  "name": "eightbit",
  "version": "1.2.0",
  "description": "A retro platformer for the terminal with truecolor pixel graphics",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salmanrrana/8-bit.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "eightbit": "bin/8bit.js"
  },
  "scripts": {
    "start": "node ./bin/8bit.js",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "oxlint",
    "format": "prettier --write",
    "check:fast": "npm run lint && npm run typecheck && npm test",
    "check:staged": "node scripts/check-staged.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  }
}
